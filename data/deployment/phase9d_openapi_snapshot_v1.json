          "team_2": {
            "minLength": 1,
            "title": "Team 2",
            "type": "string"
          },
          "winner": {
            "description": "Must be exactly team_1 or team_2.",
            "minLength": 1,
            "title": "Winner",
            "type": "string"
          }
        },
        "required": [
          "stage",
          "team_1",
          "team_2",
          "winner"
        ],
