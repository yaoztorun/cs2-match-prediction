    "/api/v1/health/ready": {
      "get": {
        "description": "`status`/the 503 gate below are governed EXCLUSIVELY by the original\nPhase 9D core contract (prediction_ready and explanation_ready) -\nunchanged from Phase 9D. `subsystems` is purely additive (Phase 9E):\ntournament_engine_ready/historical_cologne_ready are reported here for\nvisibility, but a failure in either never marks the base service\nnot-ready - each /api/v1/major/* route enforces its own required\nsubsystem independently via its own 503.",
        "operationId": "health_ready_api_v1_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
