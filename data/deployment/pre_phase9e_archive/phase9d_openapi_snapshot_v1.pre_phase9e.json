      "get": {
        "operationId": "get_contexts_api_v1_contexts_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List all registered inference contexts"
      }
    },
